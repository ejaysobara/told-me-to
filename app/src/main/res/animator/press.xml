<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator android:duration="120" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="elevation" android:valueTo="0dp" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleX" android:valueTo="0.95" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="scaleY" android:valueTo="0.95" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:interpolator="@android:interpolator/decelerate_quad" android:propertyName="elevation" android:valueTo="2dp" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:interpolator="@interpolator/soft_overshoot" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:interpolator="@interpolator/soft_overshoot" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
